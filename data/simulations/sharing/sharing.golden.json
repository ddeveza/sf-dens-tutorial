      "ruleSetId": "sharing@summer-26",
      "input": {
        "object": {
          "owd": "Private",
          "custom": false,
          "grantAccessUsingHierarchies": false
        },
        "roles": [
          {
            "id": "ceo"
          },
          {
            "id": "vp",
            "parentId": "ceo"
          },
          {
            "id": "rep",
            "parentId": "vp"
          }
        ],
        "users": [
          {
            "id": "owner",
            "roleId": "rep",
            "profile": {
              "read": true,
              "edit": true,
              "delete": true,
              "viewAll": false,
              "modifyAll": false,
              "viewAllData": false,
              "modifyAllData": false
            },
            "permissionSets": []
          },
          {
            "id": "manager",
            "roleId": "vp",
            "profile": {
              "read": true,
              "edit": true,
              "delete": true,
              "viewAll": false,
              "modifyAll": false,
              "viewAllData": false,
              "modifyAllData": false
            },
            "permissionSets": []
          }
        ],
        "record": {
          "id": "acc-1",
          "ownerId": "owner",
          "fields": {
            "Industry": "Energy"
          }
        },
        "sharingRules": [],
        "manualShares": [],
        "question": {
          "userId": "manager",
          "wants": "read"
        }
      },
      "expected": {
        "access": "full",
        "granted": true,
        "trace": [
          {
            "rule": "object_permissions",
            "effect": "gate",
            "access": "full",
            "note": "Read: profile; Edit: profile; Delete: profile. Object permissions cap record-level access at full."
          },
          {
            "rule": "modify_all",
            "effect": "none",
            "note": "No Modify All Data or Modify All Records: sharing decides."
          },
          {
            "rule": "view_all",
            "effect": "none",
            "note": "No View All Data or View All Records: sharing decides."
          },
          {
            "rule": "owner",
            "effect": "none",
            "note": "Record is owned by 'owner', not 'manager'."
          },
          {
            "rule": "owd",
            "effect": "none",
            "note": "OWD Private: no baseline; only ownership, the role hierarchy, sharing rules and shares open the record."
          },
          {
            "rule": "role_hierarchy",
            "effect": "grant",
            "access": "full",
            "note": "Grant Access Using Hierarchies is always on for standard objects; the toggle (off) is ignored. Role 'vp' is above the owner's role 'rep': the hierarchy grants owner-level access (full)."
          },
          {
            "rule": "manual_share",
            "effect": "none",
            "note": "No manual share for user 'manager'."
          },
          {
            "rule": "required_access",
            "effect": "gate",
            "access": "read",
            "note": "Wants read: needs read. Record-level access is full: granted."
          }
        ]
      }
    },
