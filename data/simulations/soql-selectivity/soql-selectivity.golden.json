    {
      "name": "OR with an unindexed branch is a full scan even when the other branch is Id IN",
      "ruleSetId": "soql-selectivity@summer-26",
      "input": {
        "totalRows": 1000000,
        "filters": [
          {
            "id": "ids",
            "field": "Id",
            "operator": "in",
            "index": "standard",
            "matchingRows": 10,
            "fieldKind": "lookup"
          },
          {
            "id": "legacy",
            "field": "Legacy_Key__c",
            "operator": "eq",
            "index": "none",
            "matchingRows": 10,
            "fieldKind": "text"
          }
        ],
        "combinator": "OR"
      },
      "expected": {
        "selective": false,
        "plan": "fullScan",
        "perFilter": [
          {
            "id": "ids",
            "usable": true,
            "threshold": 300000,
            "matchingRows": 10,
            "reason": "'Id' matches 10 of 1,000,000 rows, within the 300,000 threshold for a standard index. OR: every branch must be usable and 'Legacy_Key__c' is not, so the whole query falls back to a full scan."
          },
          {
            "id": "legacy",
            "usable": false,
            "threshold": 0,
            "matchingRows": 10,
            "reason": "'Legacy_Key__c' has no index, so the optimizer cannot use it to drive the query; a custom index would allow up to 100,000 matching rows on 1,000,000 rows."
          }
        ],
        "suggestions": [
          "add_custom_index",
          "add_selective_leading_filter"
        ]
      }
    },
