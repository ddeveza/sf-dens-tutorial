{
  "$comment": "Golden cases for lib/simulations/soql-selectivity simulate(input, ruleSet): input -> expected result. `rulesOverride` (optional) is merged onto the pinned rule set's rules. Hand-reviewed; regenerate only with UPDATE_GOLDENS=1 npx vitest run data/simulations/soql-selectivity and review the diff.",
  "cases": [
    {
      "name": "Day 23 prediction: 5M rows, custom-indexed Status__c matching 400,000 (threshold 300,000) is a full scan",
      "ruleSetId": "soql-selectivity@summer-26",
      "input": {
        "totalRows": 5000000,
        "filters": [
          {
            "id": "status",
            "field": "Status__c",
            "operator": "eq",
            "index": "custom",
            "matchingRows": 400000,
            "fieldKind": "picklist"
          }
        ],
        "combinator": "AND"
      },
      "expected": {
        "selective": false,
        "plan": "fullScan",
        "perFilter": [
          {
            "id": "status",
            "usable": false,
            "threshold": 300000,
            "matchingRows": 400000,
            "reason": "'Status__c' matches 400,000 of 5,000,000 rows, above the 300,000 threshold for a custom index: the optimizer will not use it."
          }
        ],
        "suggestions": [
          "add_selective_leading_filter",
          "reduce_scope"
        ]
      }
    },
    {
      "name": "OR-sum over threshold: two standard-index branches usable alone, union 350,000 > 300,000 on 1M rows",
      "ruleSetId": "soql-selectivity@summer-26",
      "input": {
        "totalRows": 1000000,
        "filters": [
          {
            "id": "email",
            "field": "Email",
            "operator": "eq",
            "index": "standard",
            "matchingRows": 200000,
            "fieldKind": "text"
          },
          {
            "id": "name",
            "field": "Name",
            "operator": "like",
            "index": "standard",
            "matchingRows": 150000,
            "fieldKind": "text"
          }
        ],
        "combinator": "OR"
      },
      "expected": {
        "selective": false,
        "plan": "fullScan",
        "perFilter": [
          {
            "id": "email",
            "usable": true,
            "threshold": 300000,
            "matchingRows": 200000,
            "reason": "'Email' matches 200,000 of 1,000,000 rows, within the 300,000 threshold for a standard index. OR union: the branches together match 350,000 rows, above the 300,000 threshold, so the whole query falls back to a full scan."
          },
          {
            "id": "name",
            "usable": true,
            "threshold": 300000,
            "matchingRows": 150000,
            "reason": "'Name' matches 150,000 of 1,000,000 rows, within the 300,000 threshold for a standard index. OR union: the branches together match 350,000 rows, above the 300,000 threshold, so the whole query falls back to a full scan."
          }
        ],
        "suggestions": [
          "reduce_scope"
        ]
      }
    },
